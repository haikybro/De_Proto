#include "../common.keymap"

#define WIN 0
#define WIN_FN 1
#define MAC 2
#define MAC_FN 3

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Win";
            bindings = <
&gresc     &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSLH  &kp DEL
&kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSPC
&kp LCTRL  &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT             &kp ENTER
&kp LSHFT  &trans    &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHIFT &mo WIN_FN
&trans     &kp LGUI  &kp LALT                                &kp SPACE                     &kp RALT  &kp LC(LA(DEL)) &trans &trans &trans
            >;
        };

        win_function_layer {
            label = "Win Function";
            bindings = <
&trans    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &DE_BLD    &kp INS
&trans    &trans    &kp UP    &DE_USB   &DE_BT1   &DE_BT2   &DE_BT3   &trans    &trans    &trans    &kp UP    &kp PG_UP &kp PG_DN &macro_genid
&trans    &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans    &trans    &trans    &trans    &kp LEFT  &kp DOWN  &kp RIGHT          &macro_name
&macro_username &trans &DE_SLP &trans &macro_code &bt BT_CLR_ALL &trans &open_nx &trans &trans &kp LG(L) &macro_passlogin &trans &trans
&DE_OUT   &macro_pass91 &macro_pass90                     &trans                         &trans    &kp CLCK  &macro_corp &to MAC &trans
            >;
        };

        mac_layer {
            label = "Mac";
            bindings = <
&gresc     &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSLH  &kp DEL
&kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSPC
&kp CAPS   &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT             &kp ENTER
&kp LSHFT  &trans    &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHIFT &mo MAC_FN
&kp LCTRL  &kp LALT  &kp LGUI                                &kp SPACE                     &kp RALT  &kp LC(LA(DEL)) &kp LEFT &kp DOWN &kp RIGHT
            >;
        };

        mac_function_layer {
            label = "Mac Function";
            bindings = <
&kp GRAVE &kp C_BRI_DN &kp C_BRI_UP &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS &kp C_AC_SEARCH &kp GLOBE &kp C_PREV &kp C_PP &kp C_NEXT &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &DE_BLD &kp INS
&trans    &trans    &kp UP    &DE_USB   &DE_BT1   &DE_BT2   &DE_BT3   &trans    &trans    &trans    &kp UP    &kp PG_UP &kp PG_DN &macro_genid
&trans    &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans    &trans    &trans    &trans    &kp LEFT  &kp DOWN  &kp RIGHT          &macro_name
&macro_username &trans &DE_SLP &trans &macro_code &bt BT_CLR_ALL &trans &open_nx &trans &trans &kp LG(L) &macro_passlogin &trans &trans
&DE_OUT   &macro_pass91 &macro_pass90                     &trans                         &trans    &kp CLCK  &macro_corp &to WIN &trans
            >;
        };

        layer_4 { status = "reserved"; };
        layer_5 { status = "reserved"; };

    };
};
